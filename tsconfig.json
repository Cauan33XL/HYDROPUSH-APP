{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["hydropush-react/src/*"]
    }
  },
  "include": [
    "hydropush-react/src/**/*",
    "vite.config.ts",
    "hydropush-capacitor/capacitor.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "hydropush-capacitor/android"
  ]
}