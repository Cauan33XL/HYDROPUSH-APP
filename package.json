{
  "name": "hydropush-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "hydropush-react",
    "hydropush-capacitor"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "cap:sync": "npm run cap:sync -w hydropush-capacitor",
    "cap:open": "npm run cap:open -w hydropush-capacitor",
    "android": "npm run build && npm run cap:sync && npm run cap:open"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/node": "^20.19.25",
    "eslint": "^9.39.1",
    "typescript": "^5.7.0",
    "vite": "^7.2.2"
  }
}
